# Comma-separated API key pool, at least 2 keys. Mapped in order to key_1, key_2, ...
LLM_API_KEYS=sk-placeholder-key-1,sk-placeholder-key-2

# LiteLLM model identifier used by all keys in the pool
LLM_MODEL=gemini/gemini-2.0-flash

# SQLite location. Inside Docker this must point at the mounted volume.
DATABASE_URL=sqlite:////data/app.db

# Comma-separated list of origins allowed to call the backend
ALLOWED_ORIGINS=http://localhost:3000

# true enables the X-Simulate-Failure test hook on POST /chat
ENABLE_FAILURE_SIMULATION=true

# Default system prompt used when a session does not set its own
DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.

# Base URL the frontend uses to reach the backend
VITE_API_BASE_URL=http://localhost:8000
